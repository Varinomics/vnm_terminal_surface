# vcpkg's Windows toolchain otherwise adds /Z7 and /DEBUG even to Release.
list(APPEND VCPKG_HASH_ADDITIONAL_FILES "${CMAKE_CURRENT_LIST_FILE}")
set(VCPKG_CMAKE_CONFIGURE_OPTIONS
    "-DCMAKE_MSVC_DEBUG_INFORMATION_FORMAT="
    "-DCMAKE_C_FLAGS=/nologo /DWIN32 /D_WINDOWS /utf-8"
    "-DCMAKE_CXX_FLAGS=/nologo /DWIN32 /D_WINDOWS /utf-8 /GR /EHsc"
    "-DCMAKE_C_FLAGS_RELEASE=/O2 /Oi /Gy /DNDEBUG"
    "-DCMAKE_CXX_FLAGS_RELEASE=/O2 /Oi /Gy /DNDEBUG"
    "-DCMAKE_EXE_LINKER_FLAGS_RELEASE=/DEBUG:NONE /NOCOFFGRPINFO /INCREMENTAL:NO /OPT:REF /OPT:ICF"
    "-DCMAKE_SHARED_LINKER_FLAGS_RELEASE=/DEBUG:NONE /NOCOFFGRPINFO /INCREMENTAL:NO /OPT:REF /OPT:ICF"
    "-DCMAKE_MODULE_LINKER_FLAGS_RELEASE=/DEBUG:NONE /NOCOFFGRPINFO /INCREMENTAL:NO /OPT:REF /OPT:ICF")
