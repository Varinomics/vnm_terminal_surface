include_guard(GLOBAL)

function(vnm_terminal_conpty_shared_resources package output)
    set(marked_hosts 0)
    foreach(architecture IN ITEMS x64 arm64)
        set(host "${package}/build/native/runtimes/${architecture}/OpenConsole.exe")
        if(EXISTS "${host}")
            file(STRINGS "${host}" marker REGEX "VNM_CONPTY_SHARED_SHADERS_V1" LIMIT_COUNT 1)
            if(marker)
                math(EXPR marked_hosts "${marked_hosts} + 1")
            endif()
        endif()
    endforeach()
    set(capability_error "missing receipt")
    if(EXISTS "${package}/conpty-source-build.json")
        file(READ "${package}/conpty-source-build.json" document)
        string(JSON capability ERROR_VARIABLE capability_error GET "${document}" shared_shader_resources)
    endif()
    if(capability_error)
        if(marked_hosts)
            message(FATAL_ERROR "ConPTY shared-shader hosts require their resource capability")
        endif()
        set(${output} "" PARENT_SCOPE)
        return()
    endif()
    string(JSON schema GET "${capability}" schema_version)
    string(JSON count LENGTH "${capability}" files)
    if(NOT schema EQUAL 1 OR NOT count EQUAL 4 OR NOT marked_hosts EQUAL 2)
        message(FATAL_ERROR "ConPTY shared-shader capability requires both hosts and exactly four resources")
    endif()
    set(expected conpty-shaders/shader_vs.dxbc conpty-shaders/shader_ps.dxbc
        conpty-shaders/custom_shader_vs.dxbc conpty-shaders/custom_shader_ps.dxbc)
    set(files)
    foreach(index RANGE 0 3)
        string(JSON path GET "${capability}" files ${index} path)
        if(NOT path IN_LIST expected)
            message(FATAL_ERROR "Unexpected or repeated ConPTY shader path: ${path}")
        endif()
        list(REMOVE_ITEM expected "${path}")
        string(JSON expected_size GET "${capability}" files ${index} size)
        string(JSON expected_hash GET "${capability}" files ${index} sha256)
        set(source "${package}/build/native/runtimes/${path}")
        if(NOT EXISTS "${source}")
            message(FATAL_ERROR "ConPTY shared shader is missing: ${path}")
        endif()
        file(SIZE "${source}" size)
        file(SHA256 "${source}" hash)
        if(NOT size EQUAL expected_size OR NOT hash STREQUAL expected_hash)
            message(FATAL_ERROR "ConPTY shared shader does not match its receipt: ${path}")
        endif()
        list(APPEND files "build/native/runtimes/${path}|${path}")
    endforeach()
    set(${output} "${files}" PARENT_SCOPE)
endfunction()

# Source-built packages carry their complete notices and an exact-byte receipt.
# Vendor NuGet packages retain the established redistribution license fallback.
function(vnm_terminal_stage_conpty_package source destination)
    vnm_terminal_conpty_shared_resources("${source}" shared_resources)
    set(receipt "${source}/conpty-source-build.json")
    if(EXISTS "${receipt}")
        file(READ "${receipt}" document)
        string(JSON schema GET "${document}" schema_version)
        string(JSON capability GET "${document}" capability_id)
        string(JSON configuration GET "${document}" configuration)
        string(JSON symbols GET "${document}" release_policy debug_symbols)
        string(JSON hybrid GET "${document}" release_policy hybrid_crt)
        string(JSON commit GET "${document}" upstream_commit)
        string(JSON version GET "${document}" package_version)
        if(NOT schema EQUAL 1 OR NOT capability STREQUAL "conpty-source-build" OR
            NOT configuration STREQUAL "Release" OR symbols OR NOT hybrid OR
            NOT commit STREQUAL "5a830b2bf7c053d5c7ac22208fe5a346cb5dd3dc" OR
            NOT version STREQUAL "1.24.260710001")
            message(FATAL_ERROR "Unsupported ConPTY source-build receipt: ${receipt}")
        endif()
        string(JSON count LENGTH "${document}" files)
        if(NOT count EQUAL 3)
            message(FATAL_ERROR "ConPTY source receipt must describe the DLL and both native hosts")
        endif()
        set(expected conpty.dll x64/OpenConsole.exe arm64/OpenConsole.exe)
        foreach(index RANGE 0 2)
            string(JSON path GET "${document}" files ${index} path)
            if(NOT path IN_LIST expected)
                message(FATAL_ERROR "Unexpected or repeated ConPTY source receipt path: ${path}")
            endif()
            list(REMOVE_ITEM expected "${path}")
            if(path STREQUAL "conpty.dll")
                set(binary "${source}/runtimes/win-x64/native/conpty.dll")
            else()
                set(binary "${source}/build/native/runtimes/${path}")
            endif()
            string(JSON expected_size GET "${document}" files ${index} size)
            string(JSON expected_hash GET "${document}" files ${index} sha256)
            file(SIZE "${binary}" size)
            file(SHA256 "${binary}" hash)
            if(NOT size EQUAL expected_size OR NOT hash STREQUAL expected_hash)
                message(FATAL_ERROR "ConPTY source receipt does not match ${binary}")
            endif()
        endforeach()
        string(JSON expected_license_hash GET "${document}" license_sha256)
        file(SHA256 "${source}/LICENSE" license_hash)
        if(NOT license_hash STREQUAL expected_license_hash)
            message(FATAL_ERROR "ConPTY source package notices do not match its receipt")
        endif()
        set(license "${source}/LICENSE")
    else()
        set(license "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../THIRD_PARTY/conpty/LICENSE")
    endif()

    file(MAKE_DIRECTORY "${destination}")
    file(COPY "${source}/runtimes" "${source}/build" DESTINATION "${destination}")
    configure_file("${license}" "${destination}/LICENSE" COPYONLY)
    if(EXISTS "${receipt}")
        configure_file("${receipt}" "${destination}/conpty-source-build.json" COPYONLY)
    else()
        file(REMOVE "${destination}/conpty-source-build.json")
    endif()
endfunction()
