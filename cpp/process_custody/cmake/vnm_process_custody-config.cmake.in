@PACKAGE_INIT@

set_property(GLOBAL PROPERTY VNM_PROCESS_CUSTODY_LICENSE_FILES
    "@PACKAGE_CMAKE_INSTALL_DATADIR@/licenses/vnm_process_custody/LICENSE"
    "@PACKAGE_CMAKE_INSTALL_DATADIR@/licenses/vnm_process_custody/NOTICE")

include("${CMAKE_CURRENT_LIST_DIR}/vnm_process_custody_targets.cmake")
# A surface subdirectory can resolve this package before its executable parent
# stages the helper. Promote only imports created in this directory.
get_property(_process_custody_imports DIRECTORY PROPERTY IMPORTED_TARGETS)
foreach(_process_custody_target IN ITEMS
        vnm_process_custody::vnm_process_custody vnm_process_custody::vnm_process_custody_owner)
    if(_process_custody_target IN_LIST _process_custody_imports)
        set_property(TARGET ${_process_custody_target} PROPERTY IMPORTED_GLOBAL TRUE)
    endif()
endforeach()
unset(_process_custody_imports)
unset(_process_custody_target)
include("${CMAKE_CURRENT_LIST_DIR}/vnm_process_custody_runtime.cmake")
check_required_components(vnm_process_custody)
